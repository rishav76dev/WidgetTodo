// Shared build settings for every target and configuration.
// Put machine-specific values (your team ID, the real RevenueCat key) in Config/Local.xcconfig,
// which is git-ignored and overrides the placeholders below.

// Apple Developer team ID (10 characters), e.g. DEVELOPMENT_TEAM = ABCDE12345
DEVELOPMENT_TEAM =

// RevenueCat public Apple API key; reaches the app through Info.plist key RevenueCatAPIKey.
REVENUECAT_API_KEY = appl_REPLACE_ME

#include? "Local.xcconfig"
